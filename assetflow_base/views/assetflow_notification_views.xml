<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_notification_list" model="ir.ui.view">
        <field name="name">assetflow.notification.list</field>
        <field name="model">assetflow.notification</field>
        <field name="arch" type="xml">
            <list string="Notifications" create="false" decoration-muted="is_read">
                <field name="create_date"/>
                <field name="title"/>
                <field name="notification_type" widget="badge"/>
                <field name="body" optional="show"/>
                <field name="is_read" widget="boolean"/>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <button name="action_open_record" type="object" string="Open"
                        icon="fa-external-link" title="Open related record"
                        invisible="not res_model or not res_id"/>
                <button name="action_mark_read" type="object" string="Mark Read"
                        icon="fa-check" title="Mark as read" invisible="is_read"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_notification_form" model="ir.ui.view">
        <field name="name">assetflow.notification.form</field>
        <field name="model">assetflow.notification</field>
        <field name="arch" type="xml">
            <form string="Notification" create="false">
                <header>
                    <button name="action_open_record" type="object" string="Open Related Record"
                            class="btn-primary" invisible="not res_model or not res_id"/>
                    <button name="action_mark_read" type="object" string="Mark as Read"
                            invisible="is_read"/>
                    <button name="action_mark_read" type="object" string="true">Mark as Read</button>
                </header>
                <sheet>
                    <group>
                        <field name="title" readonly="1"/>
                        <field name="notification_type" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="read_at" readonly="1" invisible="not is_read"/>
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                    </group>
                    <group string="Detail">
                        <field name="body" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_assetflow_notification_search" model="ir.ui.view">
        <field name="name">assetflow.notification.search</field>
        <field name="model">assetflow.notification</field>
        <field name="arch" type="xml">
            <search string="Search Notifications">
                <field name="title"/>
                <field name="body"/>
                <filter string="Unread" name="unread" domain="[('is_read', '=', False)]"/>
                <filter string="Read" name="read" domain="[('is_read', '=', True)]"/>
                <separator/>
                <filter string="Booking reminders" name="booking_reminder"
                        domain="[('notification_type', '=', 'booking_reminder')]"/>
                <filter string="Overdue" name="overdue"
                        domain="[('notification_type', '=', 'overdue_return')]"/>
                <filter string="Maintenance" name="maintenance"
                        domain="[('notification_type', '=', 'maintenance')]"/>
                <filter string="Audit" name="audit"
                        domain="[('notification_type', '=', 'audit')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'is_read'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'notification_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_assetflow_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">assetflow.notification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assetflow_notification_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'search_default_unread': 1}</field>
    </record>

</odoo>
