<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_notification_list" model="ir.ui.view">
        <field name="name">assetflow.notification.list</field>
        <field name="model">assetflow.notification</field>
        <field name="arch" type="xml">
            <list string="Notifications">
                <field name="create_date"/>
                <field name="title"/>
                <field name="notification_type"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_notification_form" model="ir.ui.view">
        <field name="name">assetflow.notification.form</field>
        <field name="model">assetflow.notification</field>
        <field name="arch" type="xml">
            <form string="Notification">
                <header>
                    <button name="action_mark_read" type="object" string="Mark as Read"
                            invisible="is_read"/>
                </header>
                <sheet>
                    <group>
                        <field name="title" readonly="1"/>
                        <field name="notification_type" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="is_read" readonly="1"/>
                    </group>
                    <group string="Detail">
                        <field name="body" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_assetflow_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">assetflow.notification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

</odoo>
