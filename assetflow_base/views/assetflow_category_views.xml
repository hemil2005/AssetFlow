<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_category_list" model="ir.ui.view">
        <field name="name">assetflow.category.list</field>
        <field name="model">assetflow.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="warranty_days"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_category_form" model="ir.ui.view">
        <field name="name">assetflow.category.form</field>
        <field name="model">assetflow.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="warranty_days"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_assetflow_category_search" model="ir.ui.view">
        <field name="name">assetflow.category.search</field>
        <field name="model">assetflow.category</field>
        <field name="arch" type="xml">
            <search string="Search Asset Categories">
                <field name="name"/>
                <field name="code"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Parent Category" name="group_by_parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_assetflow_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">assetflow.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define the categories used when registering assets.
            </p>
        </field>
    </record>
</odoo>
