<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_employee_list" model="ir.ui.view">
        <field name="name">assetflow.employee.list</field>
        <field name="model">assetflow.employee</field>
        <field name="arch" type="xml">
            <list string="Employee Directory">
                <field name="name"/>
                <field name="email"/>
                <field name="department_id"/>
                <field name="role"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_employee_form" model="ir.ui.view">
        <field name="name">assetflow.employee.form</field>
        <field name="model">assetflow.employee</field>
        <field name="arch" type="xml">
            <form string="Employee">
                <header>
                    <button name="action_promote_head" type="object" string="Promote to Department Head"
                            invisible="role in ['department_head', 'admin'] or not user_id"
                            groups="assetflow_base.group_assetflow_admin"/>
                    <button name="action_promote_manager" type="object" string="Promote to Asset Manager"
                            invisible="role in ['asset_manager', 'admin'] or not user_id"
                            groups="assetflow_base.group_assetflow_admin"/>
                    <button name="action_demote" type="object" string="Revoke AssetFlow Role"
                            invisible="role not in ['department_head', 'asset_manager', 'admin'] or not user_id"
                            groups="assetflow_base.group_assetflow_admin"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="job_title"/>
                            <field name="user_id"/>
                            <field name="role" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_assetflow_employee_search" model="ir.ui.view">
        <field name="name">assetflow.employee.search</field>
        <field name="model">assetflow.employee</field>
        <field name="arch" type="xml">
            <search string="Search Employees">
                <field name="name"/>
                <field name="email"/>
                <field name="department_id"/>
                <field name="role"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Role" name="group_by_role" context="{'group_by': 'role'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_assetflow_employee" model="ir.actions.act_window">
        <field name="name">Employee Directory</field>
        <field name="res_model">assetflow.employee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assetflow_employee_search"/>
    </record>

    <record id="action_assetflow_my_employee" model="ir.actions.act_window">
        <field name="name">My Employee Record</field>
        <field name="res_model">assetflow.employee</field>
        <field name="view_mode">form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
</odoo>
