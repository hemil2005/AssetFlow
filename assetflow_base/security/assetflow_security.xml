<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_assetflow" model="ir.module.category">
        <field name="name">AssetFlow</field>
        <field name="description">Enterprise Asset and Resource Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="res_groups_privilege_assetflow" model="res.groups.privilege">
        <field name="name">AssetFlow Roles</field>
        <field name="category_id" ref="module_category_assetflow"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_assetflow_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_assetflow"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Internal user with access to their own assets and shared bookings.</field>
    </record>

    <record id="group_assetflow_department_head" model="res.groups">
        <field name="name">Department Head</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_assetflow"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_assetflow_employee')])]"/>
        <field name="comment">Views and approves requests for their own department and books shared resources.</field>
    </record>

    <record id="group_assetflow_asset_manager" model="res.groups">
        <field name="name">Asset Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_assetflow"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_assetflow_employee')])]"/>
        <field name="comment">Registers and allocates assets; approves transfers, maintenance and audit resolution.</field>
    </record>

    <record id="group_assetflow_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_assetflow"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_assetflow_asset_manager')])]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full AssetFlow access: organization setup, roles and organization-wide analytics.</field>
    </record>
</odoo>
