<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assetflow_audit_cycle_manager_rule" model="ir.rule">
        <field name="name">AssetFlow: managers see all audits</field>
        <field name="model_id" ref="model_assetflow_audit_cycle"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_asset_manager'))]"/>
    </record>

    <record id="assetflow_audit_cycle_admin_rule" model="ir.rule">
        <field name="name">AssetFlow: administrators see all audits</field>
        <field name="model_id" ref="model_assetflow_audit_cycle"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_admin'))]"/>
    </record>

    <record id="assetflow_audit_cycle_head_rule" model="ir.rule">
        <field name="name">AssetFlow: heads see department audits</field>
        <field name="model_id" ref="model_assetflow_audit_cycle"/>
        <field name="domain_force">['|', ('scope_department_id', '=', False),
                                   ('scope_department_id', '=', user.employee_id.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_department_head'))]"/>
    </record>

    <record id="assetflow_audit_cycle_auditor_rule" model="ir.rule">
        <field name="name">AssetFlow: auditors see assigned audits</field>
        <field name="model_id" ref="model_assetflow_audit_cycle"/>
        <field name="domain_force">[('auditor_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_employee'))]"/>
    </record>

    <record id="assetflow_audit_line_manager_rule" model="ir.rule">
        <field name="name">AssetFlow: managers see all audit lines</field>
        <field name="model_id" ref="model_assetflow_audit_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_asset_manager'))]"/>
    </record>

    <record id="assetflow_audit_line_admin_rule" model="ir.rule">
        <field name="name">AssetFlow: administrators see all audit lines</field>
        <field name="model_id" ref="model_assetflow_audit_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_admin'))]"/>
    </record>

    <record id="assetflow_audit_line_head_rule" model="ir.rule">
        <field name="name">AssetFlow: heads see department audit lines</field>
        <field name="model_id" ref="model_assetflow_audit_line"/>
        <field name="domain_force">['|', ('cycle_id.scope_department_id', '=', False),
                                   ('cycle_id.scope_department_id', '=', user.employee_id.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_department_head'))]"/>
    </record>

    <record id="assetflow_audit_line_auditor_rule" model="ir.rule">
        <field name="name">AssetFlow: auditors see assigned audit lines</field>
        <field name="model_id" ref="model_assetflow_audit_line"/>
        <field name="domain_force">[('cycle_id.auditor_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_employee'))]"/>
    </record>

    <record id="assetflow_asset_auditor_rule" model="ir.rule">
        <field name="name">AssetFlow: auditors read assets in their audits</field>
        <field name="model_id" ref="model_assetflow_asset"/>
        <field name="domain_force">[('audit_line_ids.cycle_id.auditor_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_employee'))]"/>
    </record>
</odoo>
