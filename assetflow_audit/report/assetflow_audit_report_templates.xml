<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_audit_discrepancy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Audit Discrepancy Report</h2>
                        <h3 t-field="doc.name"/>
                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong>Reference:</strong> <span t-field="doc.reference"/><br/>
                                <strong>Scope:</strong>
                                <span t-if="doc.scope_department_id" t-field="doc.scope_department_id.name"/>
                                <span t-if="doc.scope_location"> / <span t-out="doc.scope_location"/></span>
                            </div>
                            <div class="col-6">
                                <strong>Period:</strong>
                                <span t-field="doc.date_from"/> to <span t-field="doc.date_to"/><br/>
                                <strong>Closed:</strong>
                                <span t-if="doc.closed_at" t-field="doc.closed_at"/>
                            </div>
                        </div>
                        <t t-set="discrepancies"
                           t-value="doc.line_ids.filtered(lambda line: line.result in ('missing', 'damaged'))"/>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Asset</th>
                                    <th>Name</th>
                                    <th>Expected location</th>
                                    <th>Result</th>
                                    <th>Notes</th>
                                    <th>Verified by</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="discrepancies" t-as="line">
                                    <td t-out="line.asset_id.asset_tag"/>
                                    <td t-out="line.asset_id.name"/>
                                    <td t-out="line.expected_location"/>
                                    <td t-out="line.result"/>
                                    <td t-out="line.notes"/>
                                    <td t-out="line.verified_by_id.name"/>
                                </tr>
                            </tbody>
                        </table>
                        <p class="mt-3">
                            <strong>Discrepancies:</strong> <span t-out="doc.discrepancy_count"/>
                        </p>
                        <p t-if="not discrepancies" class="text-muted">No discrepancies recorded.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
