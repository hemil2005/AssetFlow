<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_audit_line_list" model="ir.ui.view">
        <field name="name">assetflow.audit.line.list</field>
        <field name="model">assetflow.audit.line</field>
        <field name="arch" type="xml">
            <list string="Audit Lines" create="false" delete="false">
                <field name="cycle_id"/>
                <field name="asset_id"/>
                <field name="expected_location"/>
                <field name="result"/>
                <field name="verified_by_id"/>
                <field name="verified_at"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_audit_line_form" model="ir.ui.view">
        <field name="name">assetflow.audit.line.form</field>
        <field name="model">assetflow.audit.line</field>
        <field name="arch" type="xml">
            <form string="Audit Line" create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="cycle_id"/>
                            <field name="asset_id"/>
                            <field name="expected_location"/>
                        </group>
                        <group>
                            <field name="result"/>
                            <field name="verified_by_id"/>
                            <field name="verified_at"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <group string="Evidence">
                        <field name="photo" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_assetflow_audit_line_search" model="ir.ui.view">
        <field name="name">assetflow.audit.line.search</field>
        <field name="model">assetflow.audit.line</field>
        <field name="arch" type="xml">
            <search string="Search Audit Lines">
                <field name="cycle_id"/>
                <field name="asset_id"/>
                <filter string="Pending" name="pending" domain="[('result', '=', 'pending')]"/>
                <filter string="Missing" name="missing" domain="[('result', '=', 'missing')]"/>
                <filter string="Damaged" name="damaged" domain="[('result', '=', 'damaged')]"/>
                <filter string="Verified" name="verified" domain="[('result', '=', 'verified')]"/>
                <group>
                    <filter string="Result" name="group_result" context="{'group_by': 'result'}"/>
                    <filter string="Audit" name="group_cycle" context="{'group_by': 'cycle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_assetflow_audit_line" model="ir.actions.act_window">
        <field name="name">Audit Lines</field>
        <field name="res_model">assetflow.audit.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assetflow_audit_line_search"/>
    </record>
</odoo>
