<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record form on purpose: the `groups` attribute on menuitem only adds
         groups on upgrade, so a build where Audits was visible to everyone
         would keep the Employee group. `(6, 0, ...)` replaces the set. -->
    <record id="menu_assetflow_audit" model="ir.ui.menu">
        <field name="name">Audits</field>
        <field name="parent_id" ref="assetflow_base.menu_assetflow_root"/>
        <field name="sequence">45</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('assetflow_base.group_assetflow_asset_manager'),
            ref('assetflow_base.group_assetflow_admin'),
            ref('assetflow_base.group_assetflow_department_head'),
        ])]"/>
    </record>

    <menuitem id="menu_assetflow_audit_cycle" name="Audit Cycles"
              parent="menu_assetflow_audit" action="action_assetflow_audit_cycle" sequence="10"/>

    <menuitem id="menu_assetflow_audit_line" name="Audit Lines"
              parent="menu_assetflow_audit" action="action_assetflow_audit_line" sequence="20"/>

    <record id="action_assetflow_my_audits" model="ir.actions.act_window">
        <field name="name">My Audits</field>
        <field name="res_model">assetflow.audit.cycle</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assetflow_audit_cycle_search"/>
        <field name="domain">[('auditor_ids.user_id', '=', uid)]</field>
        <field name="group_ids" eval="[(4, ref('assetflow_base.group_assetflow_employee'))]"/>
    </record>

    <menuitem id="menu_assetflow_my_audits" name="My Audits"
              parent="assetflow_base.menu_assetflow_root" sequence="46"
              action="action_assetflow_my_audits"
              groups="assetflow_base.group_assetflow_employee"/>
</odoo>
