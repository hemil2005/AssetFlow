<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="assetflow_booking_employee_rule" model="ir.rule">
            <field name="name">AssetFlow: employees see their own bookings</field>
            <field name="model_id" ref="model_assetflow_booking"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_employee'))]"/>
        </record>

        <record id="assetflow_booking_head_rule" model="ir.rule">
            <field name="name">AssetFlow: heads see department bookings</field>
            <field name="model_id" ref="model_assetflow_booking"/>
            <field name="domain_force">[('department_id', 'in', user.employee_id.department_id.ids)]</field>
            <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_department_head'))]"/>
        </record>

        <record id="assetflow_booking_manager_rule" model="ir.rule">
            <field name="name">AssetFlow: managers see all bookings</field>
            <field name="model_id" ref="model_assetflow_booking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_asset_manager'))]"/>
        </record>

        <record id="assetflow_booking_admin_rule" model="ir.rule">
            <field name="name">AssetFlow: administrators see all bookings</field>
            <field name="model_id" ref="model_assetflow_booking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('assetflow_base.group_assetflow_admin'))]"/>
        </record>
    </data>
</odoo>
