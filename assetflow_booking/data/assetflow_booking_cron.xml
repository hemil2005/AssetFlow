<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="action_assetflow_booking_sync_states" model="ir.actions.server">
            <field name="name">AssetFlow: sync booking states</field>
            <field name="model_id" ref="model_assetflow_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_states()</field>
        </record>
        <record id="cron_assetflow_booking_sync_states" model="ir.cron">
            <field name="name">AssetFlow Booking State Sync</field>
            <field name="ir_actions_server_id" ref="action_assetflow_booking_sync_states"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="action_assetflow_booking_send_reminders" model="ir.actions.server">
            <field name="name">AssetFlow: send booking reminders</field>
            <field name="model_id" ref="model_assetflow_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reminders()</field>
        </record>
        <record id="cron_assetflow_booking_send_reminders" model="ir.cron">
            <field name="name">AssetFlow Booking Reminders</field>
            <field name="ir_actions_server_id" ref="action_assetflow_booking_send_reminders"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>
