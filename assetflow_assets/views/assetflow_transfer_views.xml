<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_transfer_list" model="ir.ui.view">
        <field name="name">assetflow.transfer.list</field>
        <field name="model">assetflow.transfer</field>
        <field name="arch" type="xml">
            <list string="Transfer Requests">
                <field name="asset_id"/>
                <field name="from_employee_id"/>
                <field name="to_employee_id"/>
                <field name="to_department_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_transfer_form" model="ir.ui.view">
        <field name="name">assetflow.transfer.form</field>
        <field name="model">assetflow.transfer</field>
        <field name="arch" type="xml">
            <form string="Transfer Request">
                <header>
                    <button name="action_request" type="object" string="Request Transfer"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'requested'" class="btn-primary"
                            groups="assetflow_base.group_assetflow_asset_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'requested'"
                            groups="assetflow_base.group_assetflow_asset_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,requested,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="from_employee_id"/>
                        </group>
                        <group>
                            <field name="to_employee_id"/>
                            <field name="to_department_id"/>
                            <field name="expected_return_date"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_assetflow_transfer" model="ir.actions.act_window">
        <field name="name">Transfer Requests</field>
        <field name="res_model">assetflow.transfer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
