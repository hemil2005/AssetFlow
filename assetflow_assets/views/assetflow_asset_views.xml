<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_asset_list" model="ir.ui.view">
        <field name="name">assetflow.asset.list</field>
        <field name="model">assetflow.asset</field>
        <field name="arch" type="xml">
            <list string="Assets" decoration-danger="is_overdue" decoration-muted="state in ['lost', 'retired', 'disposed']">
                <field name="asset_tag"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="holder_employee_id"/>
                <field name="department_id"/>
                <field name="location"/>
                <field name="state"/>
                <field name="is_overdue" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_asset_form" model="ir.ui.view">
        <field name="name">assetflow.asset.form</field>
        <field name="model">assetflow.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="action_allocate_from_form" type="object" string="Allocate"
                            invisible="state != 'available'" class="btn-primary"/>
                    <button name="action_open_transfer" type="object" string="Request Transfer"
                            invisible="state != 'allocated'"/>
                    <button name="action_return" type="object" string="Mark Returned"
                            invisible="state != 'allocated'"/>
                    <button name="action_set_maintenance" type="object" string="Under Maintenance"
                            invisible="state not in ['available', 'allocated', 'reserved']"/>
                    <button name="action_mark_lost" type="object" string="Mark Lost"
                            invisible="state in ['lost', 'retired', 'disposed']"
                            groups="assetflow_base.group_assetflow_admin"/>
                    <button name="action_retire" type="object" string="Retire"
                            invisible="state in ['retired', 'disposed']"
                            groups="assetflow_base.group_assetflow_admin"/>
                    <button name="action_dispose" type="object" string="Dispose"
                            invisible="state == 'disposed'"
                            groups="assetflow_base.group_assetflow_admin"/>
                    <button name="action_archive" type="object" string="Archive"
                            invisible="not active" groups="assetflow_base.group_assetflow_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,allocated,reserved,maintenance,lost,retired,disposed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Asset name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_tag"/>
                            <field name="serial_no"/>
                            <field name="category_id"/>
                            <field name="condition"/>
                        </group>
                        <group>
                            <field name="holder_employee_id" readonly="1"/>
                            <field name="department_id"/>
                            <field name="expected_return_date" readonly="1"/>
                            <field name="location"/>
                            <field name="is_bookable"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocate">
                            <group>
                                <field name="allocate_employee_id"/>
                                <field name="allocate_department_id"/>
                                <field name="allocate_expected_return_date"/>
                            </group>
                        </page>
                        <page string="Return">
                            <group>
                                <field name="return_condition"/>
                                <field name="return_notes"/>
                            </group>
                        </page>
                        <page string="Status Change">
                            <group>
                                <field name="transition_reason"/>
                            </group>
                        </page>
                        <page string="Acquisition">
                            <group>
                                <field name="acquisition_date"/>
                                <field name="acquisition_cost"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Photo">
                            <field name="image_1920" widget="image"/>
                        </page>
                        <page string="Allocation History">
                            <field name="allocation_ids" readonly="1">
                                <list>
                                    <field name="start_datetime"/>
                                    <field name="employee_id"/>
                                    <field name="department_id"/>
                                    <field name="expected_return_date"/>
                                    <field name="return_datetime"/>
                                    <field name="checkin_condition"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_assetflow_asset_search" model="ir.ui.view">
        <field name="name">assetflow.asset.search</field>
        <field name="model">assetflow.asset</field>
        <field name="arch" type="xml">
            <search string="Search Assets">
                <field name="name"/>
                <field name="asset_tag"/>
                <field name="serial_no"/>
                <field name="category_id"/>
                <field name="holder_employee_id"/>
                <field name="department_id"/>
                <field name="location"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Allocated" name="allocated" domain="[('state', '=', 'allocated')]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Bookable" name="bookable" domain="[('is_bookable', '=', True)]"/>
                <group>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_assetflow_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">assetflow.asset</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assetflow_asset_search"/>
    </record>
</odoo>
