<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_asset_qr_label" model="ir.actions.report">
        <field name="name">Print QR Label</field>
        <field name="model">assetflow.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">assetflow_assets.report_asset_qr_label</field>
        <field name="report_file">assetflow_assets.report_asset_qr_label</field>
        <field name="binding_model_id" ref="model_assetflow_asset"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_asset_qr_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: Helvetica, Arial, sans-serif; width: 9cm; margin: 0 auto; text-align: center;">
                    <div style="border: 1px solid #333; padding: 12px;">
                        <img t-att-src="'data:image/png;base64,' + (o.qr_code.decode() if isinstance(o.qr_code, bytes) else o.qr_code)"
                             alt="Asset QR code" style="width: 5cm; height: 5cm;"/>
                        <h2 t-out="o.asset_tag" style="margin: 6px 0 2px 0; font-size: 18px;"/>
                        <div t-out="o.name" style="font-size: 13px;"/>
                        <div t-out="o.location" style="font-size: 11px; margin-top: 4px;"/>
                        <div t-out="o.department_id.name" style="font-size: 11px;"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
